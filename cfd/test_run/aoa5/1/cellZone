FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "1";
    object      cellZone;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform -1;

boundaryField
{
    airFlow
    {
        type            calculated;
        value           uniform -1;
    }
    front
    {
        type            symmetryPlane;
    }
    back
    {
        type            symmetryPlane;
    }
    internalFace
    {
        type            calculated;
        value           nonuniform List<scalar> 0;
    }
    internalFace_slave
    {
        type            calculated;
        value           nonuniform List<scalar> 0;
    }
    aerofoil
    {
        type            calculated;
        value           uniform -1;
    }
}


