$--------------------------------------------------------------------MDI_HEADER
[MDI_HEADER]
FILE_TYPE = 'tir'
FILE_VERSION = 3.0
FILE_FORMAT = 'ASCII'
$--------------------------------------------------------------------------units
[UNITS]
LENGTH = 'meter'
FORCE = 'newton'
ANGLE = 'radians'
MASS = 'kg'
TIME = 'second'

$--------------------------------------------------------------------------model
[MODEL]
PROPERTY_FILE_FORMAT = 'MF_05'
USE_MODE = 14 $Tyre use switch (IUSED)
VXLOW = 1.0 $Threshold speed for scaling down forces and
moments
LONGVL = 11.176 $Measurement speed
TYRESIDE = 'LEFT' $Mounted side of tyre at vehicle/test bench
$----------------------------------------------------------------------dimension
[DIMENSION]
UNLOADED_RADIUS = 0.2032 $Free tyre radius
WIDTH = 0.1905 $Nominal section width of the tyre
ASPECT_RATIO = 0.4 $Nominal aspect ratio
RIM_RADIUS = 0.127 $Nominal rim radius
RIM_WIDTH = 0.1778 $Rim width
$-------------------------------------------------operating conditions
[OPERATING_CONDITIONS]
INFLPRES = 82737 $Tyre inflation pressure -Modify this
parameter to change inflation pressure
NOMPRES = 82737 $Nominal tyre inflation pressure -NEVER
MODIFY THIS PARAMETER
$--------------------------------------------------------------------------shape
[SHAPE]
{RADIAL_SHAPE WIDTH_SHAPE}
1.000000 0.000000
1.000000 0.400000
1.000000 0.900000
0.900000 1.000000
$----------------------------------------------------------------tire_conditions
$----------------------------------------------------------------long_slip_range
[LONG_SLIP_RANGE]
KPUMIN = -1.0 $Minimum valid wheel slip
KPUMAX = 1.0 $Maximum valid wheel slip
$---------------------------------------------------------------slip_angle_range
[SLIP_ANGLE_RANGE]
ALPMIN = -0.96 $Minimum valid slip angle
ALPMAX = 0.96 $Maximum valid slip angle
$--------------------------------------------------------inclination_angle_range
[INCLINATION_ANGLE_RANGE]
CAMMIN = -0.105 $Minimum valid camber angle
CAMMAX = 0.105 $Maximum valid camber angle
$---------------------------------------------------------vertical_force_range
[VERTICAL_FORCE_RANGE]
FZMIN = 0 $Minimum allowed wheel load
FZMAX = 1800.0 $Maximum allowed wheel load
$-------------------------------------------------------------------------------vertical
[VERTICAL]
VERTICAL_STIFFNESS = 200000.0 $Tyre vertical stiffness
VERTICAL_DAMPING = 50.0 $Tyre vertical damping
BREFF = 8.0 $Low load stiffness effective rolling radius
DREFF = 0.24 $Peak value of effective rolling radius
FREFF = 0.01 $High load stiffness effective rolling radius
FNOMIN = 1000.0 $Nominal wheel load
$-------------------------------------------------------------------scaling_coefficients
[SCALING_COEFFICIENTS]
LFZO = 0.8 $Scale factor of nominal (rated) load
LCX = 0.995 $Scale factor of Fx shape factor
LMUX = 0.78 $Scale factor of Fx peak friction coefficient
LEX = 1.0 $Scale factor of Fx curvature factor
LKX = 0.99 $Scale factor of Fx slip stiffness
LHX = 0.95 $Scale factor of Fx horizontal shift
LVX = 1.0 $Scale factor of Fx vertical shift
LGAX = 1.0 $Scale factor of camber for Fx
LCY = 1.22 $Scale factor of Fy shape factor 1.0
LMUY = 0.805 $Scale factor of Fy peak friction coefficient
LEY = 1.0 $Scale factor of Fy curvature factor 1.0
LKY = 0.88 $Scale factor of Fy cornering stiffness
LHY = 0.0 $Scale factor of Fy horizontal shift
LVY = 1.0 $Scale factor of Fy vertical shift
LGAY = 1.0 $Scale factor of camber for Fy
LTR = 1.0 $Scale factor of Peak of pneumatic trail
LRES = 1.0 $Scale factor for offset of residual torque
LGAZ = 1.0 $Scale factor of camber for Mz
LXAL = 1.0 $Scale factor of alpha influence on Fx
LYKA = 1.0 $Scale factor of kappa influence on Fy
LVYKA = 1.0 $Scale factor of kappa induced Fy
LS = 1.0 $Scale factor of Moment arm of Fx
LSGKP = 1.0 $Scale factor of Relaxation length of Fx
LSGAL = 1.0 $Scale factor of Relaxation length of Fy
LGYR = 1.04 $Scale factor of gyroscopic torque
LMX = 1.0 $Scale factor of overturning couple
LVMX = 1.0 $Scale factor of Mx vertical shift
LMY = 1.0 $Scale factor of rolling resistance torque
LIP = 1.0 $Scale factor of inflation pressure
LCZ = 1.08 $Scale factor of vertical tire stiffness
LKYG = 1.07 $Scale factor of camber stiffness
$--------------------------------------------------------------longitudinal_coefficients
[LONGITUDINAL_COEFFICIENTS]
PCX1 = 1.56182385630461 $Shape factor Cfx for longitudinal force
PDX1 = 2.85110165444411 $Longitudinal friction Mux at Fznom
PDX2 = -0.407371062621199 $Variation of friction Mux with load
PDX3 = 19.2614164371048 $Variation of friction Mux with camber -2.2142e-005
PEX1 = 0.422733521935518 $Longitudinal curvature Efx at Fznom
PEX2 = 0.0201014651759272 $Variation of curvature Efx with load -0.12336
PEX3 = 0.00229620366835657 $Variation of curvature Efx with load squared -0.03448
PEX4 = 0.00999560321822648 $Factor in curvature Efx while driving
PKX1 = 52.2555801076937 $Longitudinal slip stiffness Kfx/Fz at Fznom
PKX2 = -0.00614387636030559 $Variation of slip stiffness Kfx/Fz with load
PKX3 = -0.155693449933703 $Exponent in slip stiffness Kfx/Fz with load
PHX1 = 0.000340072159079639 $Horizontal shift Shx at Fznom
PHX2 = -0.00161506337261505 $Variation of shift Shx with load
PVX1 = -0.00331590453741636 $Vertical shift Svx/Fz at Fznom
PVX2 = 0.0788908435936460 $Variation of shift Svx/Fz with load
PPX1 = -0.705319191164713 
PPX2 = -0.589490385312056
PPX3 = -0.242820291164767
PPX4 = 0.205179565555030
RBX1 = 20.9127956557226 $Slope factor for combined slip Fx reduction
RBX2 = 13.5918110972131 $Variation of slope Fx reduction with kappa
RCX1 = 0.941365878616956 $Shape factor for combined slip Fx reduction
REX1 = 0.485208300313618 $Curvature factor of combined Fx
REX2 = -7.44585176139118e-06 $Curvature factor of combined Fx with load
RHX1 = -0.00795329716522972 $Shift factor for combined slip Fx reduction
PTX1 = 0.8 $Relaxation length SigKap0/Fz at Fznom
PTX2 = 0.000109 $Variation of SigKap0/Fz with load
PTX3 = 0.101 $Variation of SigKap0/Fz with exponent of load
PTX4 = 0.0
$---------------------------------------------------------------overturning_coefficients
[OVERTURNING_COEFFICIENTS]
QSX1 = 0.0 $Lateral force induced overturning moment
QSX2 = 0.0 $Camber induced overturning couple
QSX3 = 0.0 $Fy induced overturning couple
QSX4 = 5.0 $Fz induced overturning couple due to lateral tire deflection
QSX5 = 1.0 $Fz induced overturning couple due to lateral tire deflection
QSX6 = 10.0 $Fz induced overturning couple due to lateral tire deflection
QSX7 = 0.0 $Fz induced overturning couple due to lateral tire deflection
by inclination
QSX8 = 0.0 $Fz induced overturning couple due to lateral tire deflection by
lateral force
QSX9 = 0.4 $Fz induced overturning couple due to lateral tire deflection
by lateral force
QSX10 = 0.0 $Inclination induced overturning couple, load dependency
QSX11 = 5.0 $load dependency inclination induced overturning couple
QPX1 = 0.0 $Variation of camber effect with pressure
$-------------------------------------------------------------------lateral_coefficients
[LATERAL_COEFFICIENTS]
PCY1 = 1.477553032924075 $Shape factor Cfy for lateral forces
PDY1 = 2.419662634889429 $Lateral friction Muy
PDY2 = -0.096991237613422 $Variation of friction Muy with load
PDY3 = 9.699367924763585 $Variation of friction Muy with squared camber
PEY1 = -0.001014423462658 $Lateral curvature Efy at Fznom
PEY2 = -0.001567587511733 $Variation of curvature Efy with load
PEY3 = -26.252507850904447 $Zero order camber dependency of curvature
Efy
PEY4 = 4.418491888020646e+03 $Variation of curvature Efy with camber
PKY1 = -48.096691177591670 $Maximum value of stiffness Kfy/Fznom
PKY2 = 1.79989978802 $Load at which Kfy reaches maximum value
PKY3 = 0.776633692944650 $Variation of Kfy/Fznom with camber
PHY1 = 9.632469743033963e-05 $Horizontal shift Shy at Fznom
PHY2 = 4.485102635543676e-04 $Variation of shift Shy with load
PHY3 = 0.044112063116 $Variation of shift Shy with camber
PVY1 = -0.005996641445337 $Vertical shift in Svy/Fz at Fznom
PVY2 = 0.031420448279870 $Variation of shift Svy/Fz with load
PVY3 = -0.840635268453471 $Variation of shift Svy/Fz with camber
PVY4 = -0.482847397434584 $Variation of shift Svy/Fz with camber and load
PPY1 = 0.006522910697878 $Variation of max. stiffness Kfy/Fznom with
pressure
PPY2 = 0.732182121539935 $Variation of load at max. Kfy with pressure
PPY3 = -0.248004155399173 $Variation of friction Muy with pressure
PPY4 = 0.344037334268957 $Variation of friction Muy with pressure squared
RBY1 = 19.8262419619121 $Slope factor for combined Fy reduction
RBY2 = 12.1229468595476 $Variation of slope Fy reduction with alpha
RBY3 = 0.0283242199957536 $Shift term for alpha in slope Fy reduction
RCY1 = 0.962260226103029 $Shape factor for combined Fy reduction
REY1 = 0.543725783225437 $Curvature factor of combined Fy
REY2 = -0.124509658077830 $Curvature factor of combined Fy with load
RHY1 = 0.00209065625834598 $Shift factor for combined Fy reduction
RHY2 = 0.0105576480229759 $Shift factor for combined Fy reduction with load
RVY1 = 3.80257818367437 $Kappa induced side force Svyk/Muy*Fz at Fznom
RVY2 = -8.08711432277207 $Variation of Svyk/Muy*Fz with load
RVY3 = 87.7049041653747 $Variation of Svyk/Muy*Fz with camber
RVY4 = 3619.76539467384 $Variation of Svyk/Muy*Fz with alpha
RVY5 = -8.99305517389574 $Variation of Svyk/Muy*Fz with kappa
RVY6 = 0.00778584984494539 $Variation of Svyk/Muy*Fz with atan(kappa)
PTY1 = 0.8439 $Peak value of relaxation length SigAlp0/R0 2.1439
PTY2 = 1.9829 $Value of Fz/Fznom where SigAlp0 is extreme
PTY3 = 0.0 $Artificial damping for low speed
$-------------------------------------------------------------------rolling_coefficients
[ROLLING_COEFFICIENTS]
QSY1 = 0.01 $Rolling resistance torque coefficient
QSY2 = 0.0 $Rolling resistance torque depending on Fx
QSY3 = 0.0004 $Rolling resistance torque depending on speed
QSY4 = 4e-05 $Rolling resistance torque depending on speed ^4
$------------------------------------------------------------------aligning_coefficients
[ALIGNING_COEFFICIENTS]
QBZ1 = 9.643 $Trail slope factor for trail Bpt at Fznom
QBZ2 = 2.734 $Variation of slope Bpt with load
QBZ3 = -6.566 $Variation of slope Bpt with load squared
QBZ4 = -0.133 $Variation of slope Bpt with camber
QBZ5 = 4.954 $Variation of slope Bpt with absolute camber
QBZ9 = 16.725 $Slope factor Br of residual torque Mzr
QBZ10 = 0.809 $Slope factor Br of residual torque Mzr
QCZ1 = 1.239 $Shape factor Cpt for pneumatic trail
QDZ1 = 0.136 $Peak trail Dpt" = Dpt*(Fz/Fznom*R0)
QDZ2 = -0.022 $Variation of peak Dpt" with load
QDZ3 = -0.389 $Variation of peak Dpt" with camber
QDZ4 = -19.378 $Variation of peak Dpt" with camber squared
QDZ6 = -0.006 $Peak residual torque Dmr" = Dmr/(Fz*R0)
QDZ7 = 0.04 $Variation of peak factor Dmr" with load
QDZ8 = -2.229 $Variation of peak factor Dmr" with camber
QDZ9 = 0.61 $Variation of peak factor Dmr" with camber and load
QEZ1 = -0.368 $Trail curvature Ept at Fznom
QEZ2 = 1.062 $Variation of curvature Ept with load
QEZ3 = -1.97 $Variation of curvature Ept with load squared
QEZ4 = 0.938 $Variation of curvature Ept with sign of Alpha-t
QEZ5 = -17.303 $Variation of Ept with camber and sign Alpha-t
QHZ1 = -0.003 $Trail horizontal shift Sht at Fznom
QHZ2 = 0.011 $Variation of shift Sht with load
QHZ3 = -0.332 $Variation of shift Sht with camber
QHZ4 = -0.027 $Variation of shift Sht with camber and load
QPZ1 = 0.0 $Variation of peak Dpt" with pressure
QPZ2 = 0.0 $Variation of peak Dmr" with pressure
SSZ1 = 0.0 $Nominal value of s/R0: effect of Fx on Mz
SSZ2 = 0.0 $Variation of distance s/R0 with Fy/Fznom
SSZ3 = 0.0 $Variation of distance s/R0 with camber
SSZ4 = 0.0 $Variation of distance s/R0 with load and camber
QTZ1 = 0.0 $Gyration torque constant
MBELT = 0.0